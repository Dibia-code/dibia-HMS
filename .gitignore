# Dependencies (each app has its own node_modules)
node_modules/

# Build output
dist/
dist-ssr/
dev-dist/

# Local env files — never commit real secrets
*.local
.env
.env.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local migration credentials
/backend/*service-account*.json
/backend/scripts/migrate/*service-account*.json
/backend/scripts/migrate/.env.migration

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
