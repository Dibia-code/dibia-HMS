NODE_ENV=production
PORT=4000
HOST=0.0.0.0
JWT_SECRET=generate-a-unique-random-secret-at-least-32-characters
FRONTEND_ORIGINS=https://hms.example.com,https://console.example.com
DB_FILE=/var/lib/dibia/platform.sqlite
DATA_STORE=firestore
FIREBASE_PROJECT_ID=your-production-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
CONSOLE_ADMIN_EMAIL=admin@example.com
CONSOLE_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
DEMO_MODE=false
# Mount DB_FILE on persistent encrypted storage. Configure a shared gateway rate limit.
# Firestore server SDK uses Google IAM credentials (Application Default Credentials).
